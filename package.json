{
  "name": "osmoguard",
  "private": true,
  "version": "1.0.0",
  "description": "Simulador clínico educativo de líquidos y electrolitos (sodio).",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "npm run dev -w @osmoguard/api",
    "dev:web": "npm run dev -w @osmoguard/web",
    "build": "npm run build -w @osmoguard/web && npm run build -w @osmoguard/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e -w @osmoguard/web"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.27.7": true,
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "@embedded-postgres/linux-arm64@18.4.0-beta.17": true
  }
}
