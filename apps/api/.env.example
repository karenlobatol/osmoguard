# Entorno: development | test | production
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
DATABASE_URL=postgresql://osmoguard:osmoguard@127.0.0.1:54329/osmoguard
# Secreto HS256 para JWT de acceso (≥ 32 bytes aleatorios): openssl rand -base64 48
JWT_SECRET=change-me-change-me-change-me-change-me-123
# Clave AES-256 en base64 (32 bytes): openssl rand -base64 32
DATA_ENCRYPTION_KEY=
# Clave HMAC para seudonimizar IPs en auditoría (≥ 32 caracteres)
AUDIT_HMAC_KEY=change-me-change-me-change-me-change-me-123
# Orígenes permitidos (CORS), separados por comas. Incluir https://localhost para la app Android (Capacitor).
CORS_ORIGINS=http://localhost:5173,https://localhost
# URL pública del frontend (enlaces de recuperación de contraseña)
APP_URL=http://localhost:5173
# Cookie del refresh token: strict | lax | none (none solo con HTTPS, necesario para el APK)
REFRESH_COOKIE_SAMESITE=lax
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=14
# SMTP opcional para recuperación de contraseña. Sin SMTP, en desarrollo el enlace se imprime en consola.
SMTP_URL=
MAIL_FROM="Osmoguard <no-reply@osmoguard.local>"
# Número de proxies delante de la API (Traefik o cloudflared + nginx = 2)
TRUST_PROXY=false
# Multiplicador de rate limiting (dejar en 1 en producción)
RATE_LIMIT_FACTOR=1
# Explicaciones educativas con OpenAI (opcional, solo en el servidor)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
